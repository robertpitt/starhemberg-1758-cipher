        2240
      ],
      "interpretation": "Prima: leading 2/4/6/8 gives a three-digit group; leading 1/3/5/7/9 gives four. Secunda reverses these lengths. Leading zero gives three in both. Length interpretation agrees with the numerical tables."
    },
    {
      "id": "2",
      "box": [
        620,
        2210,
        3170,
        4030
      ],
      "interpretation": "Begin every dispatch, paragraph and letter in Prima. A switch to Secunda may follow a punctum or completed construction, with a preceding indicator; never inside a word or construction. An initial indicator is unnecessary because the start is Prima. Paragraph-boundary wording is a normalized reading of the section-symbol abbreviation."
    },
    {
      "id": "2-continuation",
      "source_file": "IMG_R1588_I7136_P2.png",
      "box": [
        240,
        150,
        2370,
        3250
      ],
      "interpretation": "Avoid frequent new paragraphs and continue the cipher without breaks where possible."
    },
    {
      "id": "3",
      "source_file": "IMG_R1588_I7136_P2.png",
      "interpretation": "Use errantes (nulls) frequently."
    },
    {
      "id": "4",
      "source_file": "IMG_R1588_I7136_P2.png",
      "interpretation": "Write no clear text between cipher groups, lest it reveal their division or meaning."
    },
    {
      "id": "5",
      "source_file": "IMG_R1588_I7136_P2.png",
      "interpretation": "Keep the enciphered expression concise; avoid unnecessary circumlocution and repetition."
    },
    {
      "id": "6",
      "source_file": "IMG_R1588_I7136_P2.png",
      "interpretation": "Omit the cipher for the final punctum as superfluous."
    }
  ],
